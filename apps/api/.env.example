PORT=3000
DATABASE_URL="file:./dev.db"

# Par Ed25519 del servidor (base64url). Se generan con: pnpm keys:generate
# (pnpm db:seed también los genera si faltan).
SERVER_ED25519_D=
SERVER_ED25519_X=

# Vida del token de sesión del backoffice.
STAFF_TOKEN_TTL_HORAS=8

# URL pública del backoffice (con la IP de la Mac) para los links de verificación de constancias.
BACKOFFICE_PUBLIC_URL=http://192.168.0.10:5173

# Habilita los endpoints /demo (adelantar reloj, forzar estados).
DEMO_MODE=true

# Latencia simulada del mock de RENAPER en ms. Vacío = aleatoria entre 1000 y 2000.
MOCK_RENAPER_LATENCIA_MS=
