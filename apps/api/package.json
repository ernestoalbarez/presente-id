{
  "name": "@presente/api",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "db:seed": "tsx scripts/setup-env.ts && prisma db push --force-reset && tsx prisma/seed.ts",
    "keys:generate": "tsx scripts/setup-env.ts --force-keys",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@presente/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "cors": "2.8.5",
    "dotenv": "16.6.1",
    "express": "5.3.0",
    "jose": "6.2.14",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "6.0.3",
    "prisma": "6.19.3",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
